# Puerto donde escucha el servidor
PORT=3000

# Clave para firmar las sesiones. CAMBIAR por un valor largo y aleatorio.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria

# Ubicacion de la base de datos SQLite
DB_PATH=./data/engel.db

# Carpeta donde se guardan los archivos de documentacion
UPLOAD_DIR=./uploads

# Tamano maximo por archivo subido, en MB
MAX_FILE_MB=25

# Usuario administrador que se crea automaticamente la primera vez
ADMIN_EMAIL=admin@engel.com
ADMIN_PASSWORD=engel1234
ADMIN_NOMBRE=Administrador

# Poner en true si la web se sirve por HTTPS (obligatorio si esta publicada)
SECURE_COOKIES=false

# Redirigir automaticamente de http a https. Activarlo solo si hay un proxy
# o servicio (Render, Fly, Nginx, Caddy) que ya termina el HTTPS.
FORZAR_HTTPS=false

# Respaldos automaticos de la base: cada cuantos minutos y cuantos conservar.
RESPALDO_CADA_MINUTOS=180
RESPALDOS_A_CONSERVAR=24
